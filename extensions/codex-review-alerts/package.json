{
  "name": "codex-review-alerts",
  "displayName": "Codex Review Alerts",
  "description": "Inline code review alerts from Codex CLI",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexReview.runReview",
        "title": "Run Codex Review"
      },
      {
        "command": "codexReview.showHistory",
        "title": "Show Review History"
      }
    ],
    "statusBarItems": [
      {
        "command": "codexReview.runReview",
        "text": "$(beaker) Codex Review",
        "tooltip": "Run Codex Review"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  }
}
